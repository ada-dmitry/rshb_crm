<main id="main-content" class="page sign-in">
  <h1>Вход фермера</h1>
  <%= form_with url: session_path do |form| %>
    <p>
      <%= form.label :email_address, "Электронная почта" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
    </p>
    <p>
      <%= form.label :password, "Пароль" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, size: 24 %>
    </p>
    <%= form.submit "Войти", class: "button button-primary" %>
  <% end %>
  <p>Регистрация и восстановление пароля по почте недоступны. Доступ выдаёт администратор.</p>
  <%= link_to "На стартовую страницу", root_path %>
</main>
