<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "CRM возврата покупателей" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rshb Stipa">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main-content">К содержимому</a>
    <header class="site-header">
      <div class="header-inner">
        <%= link_to root_path, class: "brand", aria: { label: "CRM возврата покупателей — главная" } do %>
          <span class="brand-mark" aria-hidden="true">Р</span><span>Своё хозяйство<small>CRM возврата покупателей</small></span>
        <% end %>
        <% if authenticated? %>
          <nav aria-label="Основная навигация" class="main-nav">
            <%= link_to "Обзор", crm_path, aria: { current: controller_name == "dashboard" ? "page" : nil } %>
            <%= link_to "Покупатели", customers_path, aria: { current: controller_name == "customers" ? "page" : nil } %>
            <%= link_to "Кампании", campaigns_path, aria: { current: controller_name == "campaigns" ? "page" : nil } %>
            <%= button_to "Выйти", session_path, method: :delete, class: "button button-quiet" %>
          </nav>
        <% end %>
      </div>
    </header>
    <% if authenticated? %>
      <div class="demo-banner" data-demo-banner><strong>Демонстрационный режим.</strong> Синтетические данные · реальные сообщения не отправляются.</div>
    <% end %>
    <%= tag.div(flash[:notice], role: "status", class: "flash-notice") if flash[:notice] %>
    <%= yield %>
    <footer class="site-footer">Локальный прототип · одно хозяйство · решения подтверждает фермер</footer>
  </body>
</html>
